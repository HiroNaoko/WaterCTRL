<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado SCADA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consola SCADA: Monitoreo OT"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#0D47A1" />

        <TextView
            android:id="@+id/tvEstadoEnlaceBT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enlace BT: Conectando..."
            android:textSize="14sp"
            android:textColor="#D32F2F"
            android:layout_marginBottom="16dp" />

        <!-- Tarjeta 1: Telemetría en Vivo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#CFD8DC"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telemetría en Vivo"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#263238" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Distancia HC-SR04:"
                        android:textSize="16sp"
                        android:textColor="#455A64" />

                    <TextView
                        android:id="@+id/tvDistanciaSCADA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 cm"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0277BD" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Llenado Estanque:"
                        android:textSize="16sp"
                        android:textColor="#455A64" />

                    <TextView
                        android:id="@+id/tvPorcentajeSCADA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 %"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0277BD" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSemaforoAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ESTADO: SEGURO"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#2E7D32"
                    android:background="#E8F5E9"
                    android:padding="10dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta 2: Mandos OT -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardControlesOT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#CFD8DC"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consignas de Operación (OT)"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#263238" />

                <RadioGroup
                    android:id="@+id/rgModosSCADA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/rbAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Automático (Corte por nivel en 25 cm)"
                        android:textSize="15sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manual (Habilita mando de bomba)"
                        android:textSize="15sp" />
                </RadioGroup>

                <!-- SwitchCompat universal sin incompatibilidades -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMandoManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mando Manual de Bomba"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Paro de Emergencia E-Stop -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParoEmergencia"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="PARO DE EMERGENCIA (E-STOP)"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#D32F2F"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>